{
  "name": "com6036-task-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted task manager with an independent reminder scheduler",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.build.json && npm run build:client --workspace @tasks/web",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:a11y": "node tools/accessibility-audit.mjs",
    "clean": "tsc --build --clean"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "axe-core": "^4.13.0",
    "eslint": "^9.0.0",
    "globals": "^17.12.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
